<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access to reach the RTMP media server -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Microphone capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service (general) + the specific mediaProjection type required on API 34+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Needed to post the persistent "streaming" notification on API 33+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        NOTE: There is no manifest-level permission for MediaProjection (screen capture).
        It is granted at runtime through the system consent dialog returned by
        MediaProjectionManager.createScreenCaptureIntent().
    -->

    <application
        android:name=".StreamApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenStreamApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Foreground service that owns the MediaProjection + RootEncoder RtmpDisplay
            instance. foregroundServiceType="mediaProjection" is mandatory on API 29+
            and strictly enforced (SecurityException if missing) on API 34+.
        -->
        <service
            android:name=".ScreenStreamService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>
